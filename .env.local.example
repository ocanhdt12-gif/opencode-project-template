# ═══════════════════════════════
# GIT SETUP
# ═══════════════════════════════
GIT_PLATFORM=github              # github | gitlab | bitbucket | skip
GIT_TOKEN=                       # Your Personal Access Token (see README.md#git--cicd for how to get one)
GIT_USERNAME=                    # Your git username
REPO_NAME=                       # Repository name
REPO_VISIBILITY=private          # private | public

# ═══════════════════════════════
# AGENT MODELS
# Dùng model khác nhau để tránh bias
# ═══════════════════════════════
CODING_MODEL=                    # Model viết code chính (e.g. claude-opus-4-6)
REVIEWER_MODEL=                  # Model review code — nên khác hãng với CODING (e.g. gpt-5.4)
SPEC_VALIDATOR_MODEL=            # Model validate spec — nên khác 2 cái trên (e.g. deepseek-v4-pro)

# ═══════════════════════════════
# DEPLOY
# ═══════════════════════════════
DEPLOY_PLATFORM=                 # vercel | railway | docker-vps | skip
CI_CD=                           # github-actions | gitlab-ci | skip

# ─── VPS/Docker (chỉ điền nếu DEPLOY_PLATFORM=docker-vps) ───
VPS_HOST=                        # IP hoặc domain của VPS (e.g. 123.45.67.89 hoặc myapp.com)
VPS_USER=                        # SSH user (e.g. ubuntu, root, deploy)
VPS_SSH_KEY_PATH=                # Path đến SSH private key (e.g. ~/.ssh/id_rsa)
VPS_DEPLOY_DIR=                  # Thư mục deploy trên VPS (e.g. /opt/myapp)
DOMAIN=                          # Domain chính (e.g. myapp.com) — dùng cho Nginx + SSL

# ─── Vercel (chỉ điền nếu DEPLOY_PLATFORM=vercel) ───
VERCEL_TOKEN=                    # Vercel token từ https://vercel.com/account/tokens
VERCEL_ORG_ID=                   # Org ID (lấy từ vercel link)
VERCEL_PROJECT_ID=               # Project ID (lấy từ vercel link)

# ─── Railway (chỉ điền nếu DEPLOY_PLATFORM=railway) ───
RAILWAY_TOKEN=                   # Railway token từ https://railway.app/account/tokens
RAILWAY_PROJECT_ID=              # Project ID (lấy từ railway link)

# ═══════════════════════════════
# MONITORING (OpenTelemetry) — setup ở Phase 0.5
# ═══════════════════════════════
MONITOR_ENABLED=                 # true | false — bật/tắt monitoring
OTEL_EXPORTER_OTLP_ENDPOINT=     # OTLP endpoint nhận telemetry (vd: https://otlp.example.com/v1/traces)
OTEL_EXPORTER_OTLP_TOKEN=        # Token auth cho OTLP exporter (nếu có)
OTEL_SERVICE_NAME=               # Tên service trong telemetry (vd: my-app)
OTEL_ENV=                        # Environment (vd: production, staging)
UPTIME_SERVICE=                  # Uptime service (vd: uptimerobot, skip)
UPTIME_TOKEN=                    # Uptime API token (nếu dùng API tạo monitor)

# ═══════════════════════════════
# SCALABILITY (OPTIONAL — chỉ khi user bật Scalability Option)
# Chỉ điền khi phase 1 Brainstorm chọn option=on
# ═══════════════════════════════
SCALABILITY_OPTION=              # off (mặc định) | on
SCALABILITY_TIER=                # standard | high-traffic | enterprise

# ─── Tier High-Traffic / Enterprise ───
DATABASE_URL=                    # Primary DB connection string
DATABASE_REPLICA_URL=            # Read replica connection string (Tier ≥ High-Traffic)
REDIS_URL=                       # Redis connection string (session/cache/rate limit)
QUEUE_CONNECTION=                # Queue broker: redis | kafka (Tier ≥ High-Traffic)

# ─── Tier Enterprise ───
REGION_LAYOUT=                   # single-region | multi-az | multi-region-active-passive | active-active
SHARDING_STRATEGY=               # none | distributed-sql | manual-shard
EVENT_BUS=                       # none | kafka (khi cần event-driven)
SLO_TARGET=                      # e.g. 99.9
RTO_TARGET=                      # Recovery time objective (e.g. 15m)
RPO_TARGET=                      # Recovery point objective (e.g. 5m)
