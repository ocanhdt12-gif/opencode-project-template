# ═══════════════════════════════
# GIT SETUP
# ═══════════════════════════════
GIT_PLATFORM=github              # github | gitlab | bitbucket | skip
GIT_TOKEN=                       # Your Personal Access Token
GIT_USERNAME=                    # Your git username
REPO_NAME=                       # Repository name
REPO_VISIBILITY=private          # private | public

# ═══════════════════════════════
# AGENT MODELS
# Dùng model khác nhau để tránh bias
# ═══════════════════════════════
CODING_MODEL=                    # Model viết code chính
REVIEWER_MODEL=                  # Model review code (nên khác hãng với CODING)
SPEC_VALIDATOR_MODEL=            # Model validate spec (nên khác 2 cái trên)

# ═══════════════════════════════
# DEPLOY
# ═══════════════════════════════
DEPLOY_PLATFORM=                 # vercel | railway | docker-vps | skip
